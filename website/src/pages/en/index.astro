---
import Base from "@/layouts/Base.astro";
import { faqBlocks } from "@/data/faq.en";
import { faqEntries } from "@/data/faq";

const lang = "en" as const;
const faq = faqEntries(faqBlocks);
---

<Base lang={lang} canonicalPath="/" faq={faq}>
  <section class="mx-auto max-w-[1140px] px-6 py-24">
    <p class="text-sm uppercase tracking-[0.08em] text-[var(--color-muted)]">The iPhone to-do app</p>
    <h1 class="font-serif text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] text-[var(--color-ink)]">
      A clean list every morning.
    </h1>
    <p class="mt-6 max-w-[62ch] text-[var(--color-ink-2)]">
      Page scaffold follows in the next steps.
    </p>
  </section>
</Base>
