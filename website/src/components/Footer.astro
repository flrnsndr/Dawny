---
import { type Lang, getDict, alternateLang, GITHUB_URL, CONTACT_EMAIL } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const altLang = alternateLang(lang);

const privacyPath = lang === "de" ? "/de/datenschutz/" : "/en/privacy/";
const imprintPath = lang === "de" ? "/de/impressum/" : "/en/imprint/";
const altHref = `/${altLang}/`;

const links = [
  { href: imprintPath, label: dict.footer.links.imprint },
  { href: privacyPath, label: dict.footer.links.privacy },
  { href: `mailto:${CONTACT_EMAIL}`, label: dict.footer.links.contact },
  { href: GITHUB_URL, label: dict.footer.links.github, external: true },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__mark">Dawny</p>

    <nav class="site-footer__nav" aria-label={dict.footer.links.imprint}>
      {
        links.map((l) => (
          <a
            href={l.href}
            class="site-footer__link"
            {...(l.external ? { target: "_blank", rel: "noopener" } : {})}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href={altHref}
      hreflang={altLang}
      class="site-footer__lang"
      data-ph-event="language_toggle"
      data-ph-target={altLang}
    >{altLang.toUpperCase()}</a>
  </div>

  <p class="container site-footer__made">{dict.footer.madeIn}</p>
</footer>

<style>
  .site-footer {
    background: var(--color-night);
    color: var(--color-night-muted);
    padding-block: 3.5rem 2.5rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
  .site-footer__mark {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-night-ink);
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }
  .site-footer__link {
    color: var(--color-night-muted);
    transition: color 150ms;
  }
  .site-footer__link:hover {
    color: var(--color-night-ink);
  }
  .site-footer__lang {
    margin-left: auto;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-night-muted);
    transition: color 150ms;
  }
  .site-footer__lang:hover {
    color: var(--color-night-ink);
  }
  .site-footer__made {
    margin-top: 2rem;
    font-size: 0.8125rem;
  }
  :where(.site-footer a):focus-visible {
    outline-color: var(--color-night-ink);
  }
</style>
