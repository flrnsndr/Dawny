---
import { type Lang, getDict } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
---

<section id="faq" class="relative bg-[var(--color-paper)] text-[var(--color-ink)] py-32 sm:py-44">
  <div class="container-narrow relative z-10">
    <p class="reveal text-xs font-medium uppercase tracking-[0.18em] text-[var(--color-ink-soft)]/70 mb-6">
      <span class="inline-block h-px w-8 bg-[var(--color-ink-soft)]/40 align-middle mr-3"></span>
      {dict.faq.eyebrow}
    </p>

    <h2 class="reveal text-display text-[clamp(2rem,5vw,3.75rem)] mb-14">
      {dict.faq.title}
    </h2>

    <div class="faq-list">
      {dict.faq.items.map((item, i) => (
        <article class="faq-item reveal" style={`transition-delay: ${Math.min(i, 4) * 70}ms`}>
          <h3 class="faq-question">{item.q}</h3>
          <p class="faq-answer">{item.a}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .faq-item {
    border-top: 1px solid rgba(14, 26, 46, 0.1);
    padding-top: 2rem;
  }

  .faq-question {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }

  .faq-answer {
    margin: 0;
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
</style>
