---
import { Image } from "astro:assets";
import { type Lang, getDict, alternateLang, APP_STORE_URL } from "@/i18n";
import iconDark from "@/assets/icons/dawny-icon-dark.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const altLang = alternateLang(lang);

// Map equivalent paths between languages so the language toggle on legal
// pages keeps the visitor on the equivalent page instead of 404'ing.
const pathMap: Record<string, { en: string; de: string }> = {
  "": { en: "/en/", de: "/de/" },
  privacy: { en: "/en/privacy/", de: "/de/datenschutz/" },
  datenschutz: { en: "/en/privacy/", de: "/de/datenschutz/" },
  imprint: { en: "/en/imprint/", de: "/de/impressum/" },
  impressum: { en: "/en/imprint/", de: "/de/impressum/" },
};

const segment = (Astro.url.pathname.split("/")[2] ?? "").replace(/\/+$/, "");
const altHref = pathMap[segment]?.[altLang] ?? `/${altLang}/`;
---

<header class="absolute top-0 left-0 right-0 z-30 pt-6 sm:pt-8">
  <div class="container-content flex items-center justify-between gap-4">
    <a href={`/${lang}/`} class="flex items-center gap-2.5 group" aria-label="Dawny">
      <span class="relative inline-flex items-center justify-center">
        <Image
          src={iconDark}
          alt=""
          width={36}
          height={36}
          widths={[36, 72]}
          sizes="36px"
          class="h-9 w-9 rounded-[8px] shadow-[0_8px_24px_-12px_rgba(245,176,66,0.6)]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </span>
      <span class="text-display text-[1.1rem] tracking-tight text-[var(--color-ink)]/70 group-hover:text-[var(--color-ink)] transition-colors">
        Dawny
      </span>
    </a>

    <nav class="flex items-center gap-2 sm:gap-3" aria-label={dict.nav.languageLabel}>
      <a
        href={altHref}
        hreflang={altLang}
        class="text-xs sm:text-sm font-medium text-[var(--color-ink)]/50 hover:text-[var(--color-ink)] transition-colors px-3 py-2 rounded-full hover:bg-[var(--color-ink)]/5"
        data-ph-event="language_toggle"
        data-ph-target={altLang}
      >
        <span class="uppercase tracking-wider">{altLang}</span>
      </a>
      <a
        href={APP_STORE_URL}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center transition hover:opacity-80"
        data-ph-event="appstore_click"
        data-ph-location="header"
        data-ph-target="appstore"
      >
        <img
          src={`/assets/app-store-badge-${lang}-blk.svg`}
          alt={lang === "de" ? "Laden im App Store" : "Download on the App Store"}
          width="120"
          height="40"
          class="h-8 w-auto"
          loading="eager"
          decoding="async"
        />
      </a>
    </nav>
  </div>
</header>
