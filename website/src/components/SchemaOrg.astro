---
import { type Lang, getDict, APP_STORE_URL, GITHUB_URL } from "@/i18n";
import type { FaqEntry } from "@/data/faq";

interface Props {
  lang: Lang;
  /** Canonical URL of the current page. */
  url: string;
  title: string;
  description: string;
  image: string;
  /** FAQ entries for the landing page. Emitted as one FAQPage per language. */
  faq?: FaqEntry[];
}

const { lang, url, title, description, image, faq } = Astro.props;

const dict = getDict(lang);
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const inLanguage = lang === "de" ? "de-DE" : "en-US";
const imprintPath = lang === "de" ? "/de/impressum/" : "/en/imprint/";

const ids = {
  website: `${site}/#website`,
  app: `${site}/#app`,
  person: `${site}/#person`,
  page: `${url}#webpage`,
  faq: `${url}#faq`,
};

const person = {
  "@type": "Person",
  "@id": ids.person,
  name: "Florian Schneider",
  url: `${site}${imprintPath}`,
  sameAs: [GITHUB_URL],
};

const website = {
  "@type": "WebSite",
  "@id": ids.website,
  name: "Dawny",
  url: site,
  description: dict.meta.description,
  inLanguage,
  publisher: { "@id": ids.person },
};

const app = {
  "@type": "SoftwareApplication",
  "@id": ids.app,
  name: "Dawny",
  description: dict.meta.description,
  url: site,
  operatingSystem: "iOS",
  applicationCategory: "ProductivityApplication",
  inLanguage,
  installUrl: APP_STORE_URL,
  downloadUrl: APP_STORE_URL,
  author: { "@id": ids.person },
  publisher: { "@id": ids.person },
  sameAs: [APP_STORE_URL, GITHUB_URL],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
  },
};

const webPage = {
  "@type": "WebPage",
  "@id": ids.page,
  url,
  name: title,
  description,
  inLanguage,
  isPartOf: { "@id": ids.website },
  about: { "@id": ids.app },
  primaryImageOfPage: { "@type": "ImageObject", url: image },
};

const graph: Record<string, unknown>[] = [person, website, app, webPage];

if (faq?.length) {
  graph.push({
    "@type": "FAQPage",
    "@id": ids.faq,
    inLanguage,
    isPartOf: { "@id": ids.page },
    mainEntity: faq.map((entry) => ({
      "@type": "Question",
      name: entry.question,
      acceptedAnswer: { "@type": "Answer", text: entry.answer },
    })),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
