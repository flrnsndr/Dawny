---
import { Image, getImage } from "astro:assets";
import { type Lang, getDict, alternateLang } from "@/i18n";
import iconLight from "@/assets/icons/dawny-icon-light.png";
import iconDarkSrc from "@/assets/icons/dawny-icon-dark.png";

const iconDark = await getImage({ src: iconDarkSrc, width: 56, height: 56, format: "webp" });

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const altLang = alternateLang(lang);

// The language switch is a plain link, never a stored preference (concept 2.3).
const pathMap: Record<string, { en: string; de: string }> = {
  "": { en: "/en/", de: "/de/" },
  privacy: { en: "/en/privacy/", de: "/de/datenschutz/" },
  datenschutz: { en: "/en/privacy/", de: "/de/datenschutz/" },
  imprint: { en: "/en/imprint/", de: "/de/impressum/" },
  impressum: { en: "/en/imprint/", de: "/de/impressum/" },
};
const segment = (Astro.url.pathname.split("/")[2] ?? "").replace(/\/+$/, "");
const altHref = pathMap[segment]?.[altLang] ?? `/${altLang}/`;

const links = [
  { href: `/${lang}/#reset`, label: dict.nav.links.reset },
  { href: `/${lang}/#bedienung`, label: dict.nav.links.usage },
  { href: `/${lang}/#faq-bedienung`, label: dict.nav.links.faq },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={`/${lang}/`} class="site-header__mark" aria-label="Dawny">
      <picture>
        <source srcset={iconDark.src} media="(prefers-color-scheme: dark)" />
        <Image src={iconLight} alt="" width={28} height={28} widths={[28, 56]} sizes="28px" loading="eager" />
      </picture>
      <span>Dawny</span>
    </a>

    <nav class="site-header__nav" aria-label={dict.nav.menuLabel}>
      {links.map((l) => <a href={l.href} class="site-header__link">{l.label}</a>)}
      <a
        href={altHref}
        hreflang={altLang}
        class="site-header__lang"
        data-ph-event="language_toggle"
        data-ph-target={altLang}
      >{altLang.toUpperCase()}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--color-paper) 88%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-rule);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
  }
  .site-header__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-ink);
  }
  .site-header__mark img {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 22.4%;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    font-size: 0.9375rem;
  }
  .site-header__link {
    color: var(--color-ink-2);
    border-bottom: 1px solid transparent;
    padding-block: 0.15rem;
    transition: color 150ms, border-color 150ms;
  }
  .site-header__link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }
  .site-header__lang {
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-ink-2);
    transition: color 150ms;
  }
  .site-header__lang:hover {
    color: var(--color-ink);
  }
  @media (max-width: 640px) {
    .site-header__link {
      display: none;
    }
  }
</style>
