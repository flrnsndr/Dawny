---
import { type Lang, getDict, alternateLang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const altLang = alternateLang(lang);

// The language switch is a plain link, never a stored preference (see concept 2.3).
const pathMap: Record<string, { en: string; de: string }> = {
  "": { en: "/en/", de: "/de/" },
  privacy: { en: "/en/privacy/", de: "/de/datenschutz/" },
  datenschutz: { en: "/en/privacy/", de: "/de/datenschutz/" },
  imprint: { en: "/en/imprint/", de: "/de/impressum/" },
  impressum: { en: "/en/imprint/", de: "/de/impressum/" },
};
const segment = (Astro.url.pathname.split("/")[2] ?? "").replace(/\/+$/, "");
const altHref = pathMap[segment]?.[altLang] ?? `/${altLang}/`;

const nav = dict.nav.links;
---

<header class="sticky top-0 z-40 border-b border-[var(--color-rule)] bg-[var(--color-paper)]/85 backdrop-blur">
  <div class="mx-auto flex max-w-[1140px] items-center justify-between gap-4 px-[clamp(1.25rem,4vw,2.5rem)] py-3">
    <a href={`/${lang}/`} class="font-serif text-xl text-[var(--color-ink)]" aria-label="Dawny">Dawny</a>

    <nav class="flex items-center gap-4 text-sm" aria-label={dict.nav.menuLabel}>
      <a href={`/${lang}/#reset`} class="hidden text-[var(--color-ink-2)] hover:text-[var(--color-ink)] sm:inline">{nav.reset}</a>
      <a href={`/${lang}/#bedienung`} class="hidden text-[var(--color-ink-2)] hover:text-[var(--color-ink)] sm:inline">{nav.usage}</a>
      <a href={`/${lang}/#faq-bedienung`} class="hidden text-[var(--color-ink-2)] hover:text-[var(--color-ink)] sm:inline">{nav.faq}</a>
      <a
        href={altHref}
        hreflang={altLang}
        class="font-medium uppercase tracking-wider text-[var(--color-ink-2)] hover:text-[var(--color-ink)]"
        data-ph-event="language_toggle"
        data-ph-target={altLang}
      >{altLang}</a>
    </nav>
  </div>
</header>
