---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  kicker: string;
  heading: string;
  /** Lead paragraph. May contain inline <strong>. */
  lead: string;
  /** Optional bullet list. Each item may contain inline <strong>. */
  list?: string[];
  /** Optional closing paragraph. */
  close?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Image on the left instead of the right. */
  reversed?: boolean;
  /** Heading level for the block title. Defaults to h2. */
  as?: "h2" | "h3";
}

const {
  kicker,
  heading,
  lead,
  list = [],
  close,
  image,
  imageAlt,
  reversed = false,
  as: Heading = "h2",
} = Astro.props;
---

<div class:list={["split", { "split--reversed": reversed }]} data-reveal>
  <div class="split__text">
    <p class="kicker">{kicker}</p>
    <Heading class="split__heading">{heading}</Heading>
    <p class="split__lead" set:html={lead} />
    {
      list.length > 0 && (
        <ul class="split__list">
          {list.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
      )
    }
    {close && <p class="split__close">{close}</p>}
  </div>

  <div class="split__media">
    <Image
      class="shot"
      src={image}
      alt={imageAlt}
      widths={[320, 480, 660]}
      sizes="(min-width: 900px) 40vw, 80vw"
      loading="lazy"
    />
  </div>
</div>

<style>
  .split {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.05fr 0.95fr;
    }
    .split--reversed .split__text {
      order: 2;
    }
  }
  .split__heading {
    margin-top: 0.75rem;
  }
  .split__lead {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--color-ink-2);
  }
  .split__list {
    margin-top: 1.25rem;
    max-width: 46ch;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  .split__list li {
    padding-left: 1.25rem;
    position: relative;
    color: var(--color-ink-2);
  }
  .split__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-accent);
  }
  .split__list :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .split__lead :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .split__close {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--color-ink-2);
  }
  .split__media {
    display: flex;
    justify-content: center;
  }
  .split__media :global(img) {
    width: min(300px, 80%);
    height: auto;
  }
</style>
